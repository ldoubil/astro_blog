<style is:global>
	.theme-fx {
		position: fixed;
		inset: 0;
		z-index: 100000;
		pointer-events: none;
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.theme-fx-blob {
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 9999px;
		display: grid;
		place-items: center;
		font-size: 2.4rem;
		line-height: 1;
		box-shadow: 0 0 0 0 transparent;
		animation: theme-fx-pop 0.75s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
	}

	.theme-fx.is-dark .theme-fx-blob {
		background: radial-gradient(
			circle,
			oklch(0.45 0.08 250),
			oklch(0.22 0.04 250)
		);
		color: #f8fafc;
	}

	.theme-fx.is-light .theme-fx-blob {
		background: radial-gradient(
			circle,
			oklch(0.95 0.08 85),
			oklch(0.82 0.12 70)
		);
		color: #92400e;
	}

	.theme-fx-veil {
		position: absolute;
		inset: -20%;
		opacity: 0;
		animation: theme-fx-veil 0.75s ease forwards;
	}

	.theme-fx.is-dark .theme-fx-veil {
		background: radial-gradient(
			circle at 50% 45%,
			transparent 0%,
			oklch(0.18 0.03 var(--hue)) 55%,
			oklch(0.14 0.02 var(--hue)) 100%
		);
	}

	.theme-fx.is-light .theme-fx-veil {
		background: radial-gradient(
			circle at 50% 45%,
			transparent 0%,
			oklch(0.97 0.02 var(--hue)) 55%,
			oklch(0.94 0.03 var(--hue)) 100%
		);
	}

	@keyframes theme-fx-pop {
		0% {
			transform: scale(0.4);
			opacity: 0;
			box-shadow: 0 0 0 0 transparent;
		}
		35% {
			transform: scale(1.15);
			opacity: 1;
			box-shadow: 0 0 0 18px
				color-mix(in oklch, var(--primary) 18%, transparent);
		}
		100% {
			transform: scale(1);
			opacity: 0;
			box-shadow: 0 0 0 60px transparent;
		}
	}

	@keyframes theme-fx-veil {
		0% {
			opacity: 0;
		}
		30% {
			opacity: 0.55;
		}
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-fx {
			display: none !important;
		}
	}
</style>
