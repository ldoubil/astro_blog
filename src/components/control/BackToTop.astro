---
import { Icon } from 'astro-icon/components'
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<!-- Styles live in styles/back-to-top.css (global) so Swup updateHead can't break them -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center justify-center transition" onclick="backToTop()">
        <svg class="back-to-top-ring" viewBox="0 0 64 64" aria-hidden="true">
            <circle class="back-to-top-ring-track" cx="32" cy="32" r="29"></circle>
            <circle id="reading-progress-ring" class="back-to-top-ring-bar" cx="32" cy="32" r="29"></circle>
        </svg>
        <button aria-label="Back to Top" class="back-to-top-core btn-card relative z-[1]">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<script is:raw is:inline>
function backToTop() {
    const viewport = document.querySelector('[data-overlayscrollbars-viewport]');
    if (viewport) {
        viewport.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
        window.scroll({ top: 0, behavior: 'smooth' });
    }
}
</script>
