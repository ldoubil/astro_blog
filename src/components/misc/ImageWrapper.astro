---
import path from "path";
import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

interface Props {
    id?: string;
    src: string;
    class?: string;
    alt?: string;
    position?: string;
    basePath?: string;
}

const { id, src, alt, position = "center", basePath = "/" } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
    src.startsWith("/") ||
    src.startsWith("http") ||
    src.startsWith("https") ||
    src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img: ImageMetadata | undefined;

if (isLocal) {
    const files = import.meta.glob<ImageMetadata>("../../**", {
        import: "default",
    });
    const normalizedPath = path
        .normalize(path.join("../../", basePath, src))
        .replace(/\\/g, "/");
    const file = files[normalizedPath];
    if (!file) {
        console.error(
            `\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
        );
    } else {
        img = await file();
    }
}

const imageClass =
    "img-el w-full h-full object-cover opacity-0 transition-opacity duration-500";
const imageStyle = `object-position: ${position}`;
---

<div id={id} class:list={[className, "overflow-hidden relative img-wrapper"]}>
    <div
        class="img-skeleton absolute inset-0 z-[1] pointer-events-none overflow-hidden"
        aria-hidden="true"
    >
        <div
            class="absolute inset-0 -translate-x-full animate-[img-shimmer_1.6s_ease-in-out_infinite] bg-gradient-to-r from-transparent via-[color-mix(in_oklch,var(--primary)_22%,transparent)] to-transparent"
        >
        </div>
    </div>
    <div
        class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none z-[2]"
    >
    </div>
    {
        isLocal && img && (
            <Image
                src={img}
                alt={alt || ""}
                class={imageClass}
                style={imageStyle}
                loading="lazy"
            />
        )
    }
    {
        !isLocal && (
            <img
                src={isPublic ? url(src) : src}
                alt={alt || ""}
                class={imageClass}
                style={imageStyle}
                loading="lazy"
                decoding="async"
            />
        )
    }
</div>

<style is:global>
    @keyframes img-shimmer {
        100% {
            transform: translateX(100%);
        }
    }

    .img-skeleton {
        background: color-mix(in oklch, var(--btn-regular-bg) 82%, var(--primary));
    }

    :is(html.dark) .img-skeleton {
        background: color-mix(in oklch, var(--btn-regular-bg) 88%, var(--primary));
    }

    .img-wrapper.is-loaded .img-skeleton {
        opacity: 0;
        transition: opacity 0.35s ease;
        pointer-events: none;
    }

    .img-wrapper .img-el.is-loaded {
        opacity: 1;
    }
</style>

<script>
    function markLoaded(img: HTMLImageElement) {
        img.classList.add("is-loaded");
        img.closest(".img-wrapper")?.classList.add("is-loaded");
    }

    function bindImage(img: HTMLImageElement) {
        if (img.dataset.skeletonBound === "1") return;
        img.dataset.skeletonBound = "1";

        if (img.complete && img.naturalWidth > 0) {
            markLoaded(img);
            return;
        }

        img.addEventListener("load", () => markLoaded(img), { once: true });
        img.addEventListener(
            "error",
            () => img.closest(".img-wrapper")?.classList.add("is-loaded"),
            { once: true },
        );
    }

    function initImageSkeletons(root: ParentNode = document) {
        root.querySelectorAll<HTMLImageElement>(".img-wrapper .img-el").forEach(bindImage);
    }

    initImageSkeletons();
    document.addEventListener("astro:page-load", () => initImageSkeletons());
    document.addEventListener("swup:page:view", () => initImageSkeletons());
    document.addEventListener("swup:content:replace", () => initImageSkeletons());
</script>
