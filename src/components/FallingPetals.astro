---
---

<canvas id="falling-petals" class="falling-petals" aria-hidden="true"></canvas>

<style is:global>
	.falling-petals {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 40;
		opacity: 0.85;
	}

	@media (prefers-reduced-motion: reduce) {
		.falling-petals {
			display: none !important;
		}
	}
</style>

<script>
	type Season = "spring" | "summer" | "autumn" | "winter";

	type Particle = {
		x: number;
		y: number;
		size: number;
		speedY: number;
		speedX: number;
		swing: number;
		swingSpeed: number;
		angle: number;
		spin: number;
		alpha: number;
		hue: number;
	};

	function currentSeason(): Season {
		const m = new Date().getMonth() + 1;
		if (m >= 3 && m <= 5) return "spring";
		if (m >= 6 && m <= 8) return "summer";
		if (m >= 9 && m <= 11) return "autumn";
		return "winter";
	}

	const canvasEl = document.getElementById("falling-petals");
	if (!(canvasEl instanceof HTMLCanvasElement)) {
		// no-op
	} else if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		canvasEl.remove();
	} else {
		const surface = canvasEl.getContext("2d");
		if (!surface) {
			canvasEl.remove();
		} else {
			const canvas = canvasEl;
			const ctx = surface;
			const season = currentSeason();
			const COUNT = season === "winter" ? 28 : 18;
			let particles: Particle[] = [];
			let width = 0;
			let height = 0;
			let raf = 0;
			let running = true;
			let themeHue = 345;

			function readHue() {
				const raw = getComputedStyle(document.documentElement)
					.getPropertyValue("--hue")
					.trim();
				const n = Number(raw);
				themeHue = Number.isFinite(n) ? n : 250;
			}

			function baseHue() {
				if (season === "spring") return 330 + ((themeHue % 60) - 30) * 0.15;
				if (season === "summer") return 145 + ((themeHue % 40) - 20) * 0.1;
				if (season === "autumn") return 45 + Math.random() * 30;
				return 210;
			}

			function resize() {
				width = window.innerWidth;
				height = window.innerHeight;
				const dpr = Math.min(window.devicePixelRatio || 1, 2);
				canvas.width = Math.floor(width * dpr);
				canvas.height = Math.floor(height * dpr);
				canvas.style.width = `${width}px`;
				canvas.style.height = `${height}px`;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			}

			function makeParticle(spawnTop = false): Particle {
				const winter = season === "winter";
				return {
					x: Math.random() * width,
					y: spawnTop ? -20 - Math.random() * height * 0.3 : Math.random() * height,
					size: winter ? 2 + Math.random() * 3.5 : 6 + Math.random() * 8,
					speedY: winter ? 0.45 + Math.random() * 0.7 : 0.35 + Math.random() * 0.55,
					speedX: winter ? -0.35 + Math.random() * 0.7 : -0.25 + Math.random() * 0.5,
					swing: Math.random() * Math.PI * 2,
					swingSpeed: 0.008 + Math.random() * 0.012,
					angle: Math.random() * Math.PI * 2,
					spin: winter ? 0 : -0.02 + Math.random() * 0.04,
					alpha: winter ? 0.45 + Math.random() * 0.4 : 0.35 + Math.random() * 0.4,
					hue: baseHue(),
				};
			}

			function drawPetal(p: Particle) {
				ctx.save();
				ctx.translate(p.x, p.y);
				ctx.rotate(p.angle);
				ctx.scale(1, season === "autumn" ? 0.55 : 0.72);
				ctx.globalAlpha = p.alpha;

				const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, p.size);
				if (season === "autumn") {
					grad.addColorStop(0, `oklch(0.78 0.14 ${p.hue} / 0.95)`);
					grad.addColorStop(0.55, `oklch(0.65 0.14 ${p.hue} / 0.75)`);
					grad.addColorStop(1, `oklch(0.55 0.1 ${p.hue} / 0)`);
				} else if (season === "summer") {
					grad.addColorStop(0, `oklch(0.9 0.08 ${p.hue} / 0.9)`);
					grad.addColorStop(0.55, `oklch(0.78 0.1 ${p.hue} / 0.65)`);
					grad.addColorStop(1, `oklch(0.7 0.08 ${p.hue} / 0)`);
				} else {
					grad.addColorStop(0, `oklch(0.92 0.06 ${p.hue} / 0.95)`);
					grad.addColorStop(0.55, `oklch(0.82 0.1 ${p.hue} / 0.75)`);
					grad.addColorStop(1, `oklch(0.78 0.08 ${p.hue} / 0)`);
				}

				ctx.fillStyle = grad;
				ctx.beginPath();
				ctx.moveTo(0, 0);
				ctx.bezierCurveTo(p.size * 0.55, -p.size * 0.9, p.size * 1.1, -p.size * 0.2, 0, p.size);
				ctx.bezierCurveTo(-p.size * 1.1, -p.size * 0.2, -p.size * 0.55, -p.size * 0.9, 0, 0);
				ctx.fill();
				ctx.restore();
			}

			function drawSnowflake(p: Particle) {
				ctx.save();
				ctx.translate(p.x, p.y);
				ctx.globalAlpha = p.alpha;
				ctx.fillStyle = `oklch(0.96 0.01 ${themeHue} / 0.95)`;
				ctx.beginPath();
				ctx.arc(0, 0, p.size, 0, Math.PI * 2);
				ctx.fill();
				ctx.restore();
			}

			function tick() {
				if (!running) return;
				ctx.clearRect(0, 0, width, height);

				for (const p of particles) {
					p.swing += p.swingSpeed;
					p.x += p.speedX + Math.sin(p.swing) * (season === "winter" ? 0.55 : 0.35);
					p.y += p.speedY;
					p.angle += p.spin;

					if (p.y > height + 30 || p.x < -40 || p.x > width + 40) {
						Object.assign(p, makeParticle(true));
					}
					if (season === "winter") drawSnowflake(p);
					else drawPetal(p);
				}

				raf = requestAnimationFrame(tick);
			}

			function start() {
				readHue();
				resize();
				particles = Array.from({ length: COUNT }, () => makeParticle(false));
				cancelAnimationFrame(raf);
				running = true;
				raf = requestAnimationFrame(tick);
			}

			function stop() {
				running = false;
				cancelAnimationFrame(raf);
				ctx.clearRect(0, 0, width, height);
			}

			start();

			window.addEventListener(
				"resize",
				() => {
					resize();
				},
				{ passive: true },
			);

			document.addEventListener("visibilitychange", () => {
				if (document.hidden) stop();
				else start();
			});

			const observer = new MutationObserver(() => readHue());
			observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["style", "class"],
			});
		}
	}
</script>
