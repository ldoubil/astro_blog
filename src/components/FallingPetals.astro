---
---

<canvas id="falling-petals" class="falling-petals" aria-hidden="true"></canvas>

<style is:global>
	.falling-petals {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 40;
		opacity: 0.85;
	}

	@media (prefers-reduced-motion: reduce) {
		.falling-petals {
			display: none !important;
		}
	}
</style>

<script>
	type Petal = {
		x: number;
		y: number;
		size: number;
		speedY: number;
		speedX: number;
		swing: number;
		swingSpeed: number;
		angle: number;
		spin: number;
		alpha: number;
	};

	const canvas = document.getElementById("falling-petals") as HTMLCanvasElement | null;
	if (!canvas) {
		// no-op
	} else if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		canvas.remove();
	} else {
		const ctx = canvas.getContext("2d");
		if (!ctx) {
			canvas.remove();
		} else {
			const COUNT = 18;
			let petals: Petal[] = [];
			let width = 0;
			let height = 0;
			let raf = 0;
			let running = true;
			let hue = 345;

			function readHue() {
				const raw = getComputedStyle(document.documentElement)
					.getPropertyValue("--hue")
					.trim();
				const n = Number(raw);
				// Soft sakura leaning pink; bias theme hue lightly
				hue = Number.isFinite(n) ? 330 + ((n % 60) - 30) * 0.15 : 345;
			}

			function resize() {
				width = window.innerWidth;
				height = window.innerHeight;
				const dpr = Math.min(window.devicePixelRatio || 1, 2);
				canvas.width = Math.floor(width * dpr);
				canvas.height = Math.floor(height * dpr);
				canvas.style.width = `${width}px`;
				canvas.style.height = `${height}px`;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			}

			function makePetal(spawnTop = false): Petal {
				return {
					x: Math.random() * width,
					y: spawnTop ? -20 - Math.random() * height * 0.3 : Math.random() * height,
					size: 6 + Math.random() * 8,
					speedY: 0.35 + Math.random() * 0.55,
					speedX: -0.25 + Math.random() * 0.5,
					swing: Math.random() * Math.PI * 2,
					swingSpeed: 0.008 + Math.random() * 0.012,
					angle: Math.random() * Math.PI * 2,
					spin: (-0.02 + Math.random() * 0.04),
					alpha: 0.35 + Math.random() * 0.4,
				};
			}

			function drawPetal(p: Petal) {
				ctx.save();
				ctx.translate(p.x, p.y);
				ctx.rotate(p.angle);
				ctx.scale(1, 0.72);
				ctx.globalAlpha = p.alpha;

				const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, p.size);
				grad.addColorStop(0, `oklch(0.92 0.06 ${hue} / 0.95)`);
				grad.addColorStop(0.55, `oklch(0.82 0.1 ${hue} / 0.75)`);
				grad.addColorStop(1, `oklch(0.78 0.08 ${hue} / 0)`);

				ctx.fillStyle = grad;
				ctx.beginPath();
				ctx.moveTo(0, 0);
				ctx.bezierCurveTo(p.size * 0.55, -p.size * 0.9, p.size * 1.1, -p.size * 0.2, 0, p.size);
				ctx.bezierCurveTo(-p.size * 1.1, -p.size * 0.2, -p.size * 0.55, -p.size * 0.9, 0, 0);
				ctx.fill();
				ctx.restore();
			}

			function tick() {
				if (!running) return;
				ctx.clearRect(0, 0, width, height);

				for (const p of petals) {
					p.swing += p.swingSpeed;
					p.x += p.speedX + Math.sin(p.swing) * 0.35;
					p.y += p.speedY;
					p.angle += p.spin;

					if (p.y > height + 30 || p.x < -40 || p.x > width + 40) {
						Object.assign(p, makePetal(true));
					}
					drawPetal(p);
				}

				raf = requestAnimationFrame(tick);
			}

			function start() {
				readHue();
				resize();
				petals = Array.from({ length: COUNT }, () => makePetal(false));
				cancelAnimationFrame(raf);
				running = true;
				raf = requestAnimationFrame(tick);
			}

			function stop() {
				running = false;
				cancelAnimationFrame(raf);
				ctx.clearRect(0, 0, width, height);
			}

			start();

			window.addEventListener(
				"resize",
				() => {
					resize();
				},
				{ passive: true },
			);

			document.addEventListener("visibilitychange", () => {
				if (document.hidden) stop();
				else start();
			});

			// Theme hue may change from settings panel
			const observer = new MutationObserver(() => readHue());
			observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["style", "class"],
			});
		}
	}
</script>
