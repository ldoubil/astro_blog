---
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { friendsConfig } from '../config'
import I18nKey from '../i18n/i18nKey'
import { i18n } from '../i18n/translation'
import { Icon } from 'astro-icon/components'

const title = friendsConfig.title || i18n(I18nKey.friends)
const description = friendsConfig.description || i18n(I18nKey.friends)
const links = friendsConfig.links
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
      <h1 class="text-2xl font-bold text-black/90 dark:text-white/90 mb-2 onload-animation">
        {title}
      </h1>
      {
        friendsConfig.description && (
          <p class="text-black/55 dark:text-white/55 mb-6 onload-animation">
            {friendsConfig.description}
          </p>
        )
      }

      {
        links.length === 0 ? (
          <p class="text-black/45 dark:text-white/45">{i18n(I18nKey.friendsEmpty)}</p>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 onload-animation">
            {links.map((friend) => (
              <a
                href={friend.url}
                target="_blank"
                rel="noopener noreferrer"
                class="friend-card group flex items-center gap-3 rounded-xl px-3 py-3 transition active:scale-[0.98]"
              >
                <div class="friend-avatar shrink-0 w-12 h-12 rounded-full overflow-hidden bg-black/5 dark:bg-white/10 transition will-change-transform">
                  {friend.avatar ? (
                    <img
                      src={friend.avatar}
                      alt={friend.name}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-[var(--primary)]">
                      <Icon name="fa6-solid:link" class="text-lg" />
                    </div>
                  )}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="font-medium text-black/85 dark:text-white/85 truncate group-hover:text-[var(--primary)] transition">
                    {friend.name}
                  </div>
                  {friend.description && (
                    <div class="text-sm text-black/45 dark:text-white/45 truncate mt-0.5">
                      {friend.description}
                    </div>
                  )}
                </div>
                <Icon
                  name="fa6-solid:arrow-up-right-from-square"
                  class="shrink-0 text-black/25 dark:text-white/25 text-sm opacity-0 group-hover:opacity-100 transition"
                />
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</MainGridLayout>

<style is:global>
  .friend-card {
    background: color-mix(in oklch, var(--card-bg) 92%, var(--primary));
  }
  .friend-card:hover {
    background: color-mix(in oklch, var(--card-bg) 82%, var(--primary));
  }
  .friend-card:hover .friend-avatar {
    animation: friend-bob 1.15s ease-in-out infinite;
  }
  @keyframes friend-bob {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    35% {
      transform: translateY(-3px) rotate(-5deg);
    }
    70% {
      transform: translateY(-1px) rotate(4deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .friend-card:hover .friend-avatar {
      animation: none;
    }
  }
</style>
