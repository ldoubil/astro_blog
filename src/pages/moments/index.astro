---
import { getCollection, render } from 'astro:content'
import MainGridLayout from '../../layouts/MainGridLayout.astro'
import Markdown from '../../components/misc/Markdown.astro'
import I18nKey from '../../i18n/i18nKey'
import { i18n } from '../../i18n/translation'
import { formatDateToYYYYMMDD } from '../../utils/date-utils'

const title = i18n(I18nKey.moments)

const moments = (await getCollection('moments', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true
})).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())

const rendered = await Promise.all(
  moments.map(async (entry) => {
    const { Content } = await render(entry)
    return { entry, Content }
  }),
)
---

<MainGridLayout title={title} description={title}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
      <h1 class="text-2xl font-bold text-black/90 dark:text-white/90 mb-6 onload-animation">
        {title}
      </h1>

      {rendered.length === 0 ? (
        <p class="text-black/45 dark:text-white/45">{i18n(I18nKey.momentsEmpty)}</p>
      ) : (
        <div class="relative pl-4 md:pl-5">
          <div
            class="absolute left-[0.35rem] md:left-[0.45rem] top-2 bottom-2 w-px bg-black/10 dark:bg-white/15"
            aria-hidden="true"
          ></div>
          <ul class="flex flex-col gap-6">
            {rendered.map(({ entry, Content }, i) => (
              <li
                id={`moment-${entry.id}`}
                class="relative onload-animation scroll-mt-24"
                style={`animation-delay: calc(var(--content-delay) + ${i * 40}ms)`}
              >
                <span
                  class="absolute -left-4 md:-left-5 top-1.5 w-2.5 h-2.5 rounded-full bg-[var(--primary)] ring-4 ring-[var(--card-bg)]"
                  aria-hidden="true"
                ></span>
                <time
                  datetime={entry.data.published.toISOString()}
                  class="block text-xs text-black/40 dark:text-white/40 mb-2 font-medium"
                >
                  {formatDateToYYYYMMDD(entry.data.published)}
                </time>
                <div class="moment-body text-black/75 dark:text-white/75 leading-relaxed">
                  <Markdown class="moment-md">
                    <Content />
                  </Markdown>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</MainGridLayout>

<style is:global>
  .moment-body .custom-md > :first-child {
    margin-top: 0;
  }
  .moment-body .custom-md > :last-child {
    margin-bottom: 0;
  }
</style>
