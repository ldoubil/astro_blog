---
import MainGridLayout from '../../layouts/MainGridLayout.astro'
import MomentCard from '../../components/MomentCard.astro'
import I18nKey from '../../i18n/i18nKey'
import { i18n } from '../../i18n/translation'
import { getSortedMoments } from '../../utils/content-utils'

const title = i18n(I18nKey.moments)
const moments = await getSortedMoments()
---

<MainGridLayout title={title} description={title}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="relative w-full">
      <h1 class="text-2xl font-bold text-black/90 dark:text-white/90 mb-4 px-1 onload-animation">
        {title}
      </h1>

      {moments.length === 0 ? (
        <div class="card-base z-10 px-6 md:px-9 py-6">
          <p class="text-black/45 dark:text-white/45">{i18n(I18nKey.momentsEmpty)}</p>
        </div>
      ) : (
        <div class="flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
          {moments.map((entry, i) => (
            <MomentCard
              entry={entry}
              published={entry.data.published}
              class:list="onload-animation"
              style={`animation-delay: calc(var(--content-delay) + ${i * 40}ms)`}
            />
          ))}
        </div>
      )}
    </div>
  </div>
</MainGridLayout>
